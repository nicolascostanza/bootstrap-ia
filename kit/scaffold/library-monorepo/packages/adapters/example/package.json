{
  "name": "@org/adapter-example",
  "version": "0.1.0",
  "description": "Adapter de ejemplo que implementa StorageAdapter de @org/core",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack ."
  },
  "peerDependencies": {
    "@org/core": "workspace:*"
  },
  "devDependencies": {
    "@org/core": "workspace:*"
  }
}
