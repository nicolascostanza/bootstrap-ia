    "jurisdiction": "AR",
    "docs": ["tos", "privacy", "cookies"],
    "compliance": "gdpr-lite"
  },
  "finance": {
    "pricing": "subscription",
    "model": "saas-simple",
    "invoicing": "manual"
  },
  "ops": {
    "support": "email+faq",
    "observability": ["sentry", "axiom", "better-stack"],
    "onboarding": "doc+emails",
    "finops": "guardrails"
  },
  "founderOs": [
