{
  "$comment": "Fuente unica de verdad del kit. Todo por defecto, todo configurable con /configure.",
  "kitVersion": "0.2.0",
  "project": {
    "name": "",
    "type": "web-app",
    "deliverables": ["web-app"],
    "jurisdiction": "AR",
    "stage": "bootstrapped",
    "language": "es"
  },
  "engineering": {
    "packageManager": "pnpm",
    "styling": "tailwind+shadcn",
    "database": "drizzle",
    "dbHost": "neon",
    "auth": "neon-auth",
    "login": ["google", "email-magic-link"],
    "twoFactor": ["email-otp", "totp"],
    "testing": "jest+rtl+playwright",
    "lint": "eslint+prettier",
    "validation": "zod",
    "accessibility": "wcag-aa",
    "git": "git-flow+conventional-commits",
    "worktrees": "per-feature",
    "ports": "deterministic",
    "portsBase": 3000,
    "portsRange": 999,
    "dbPerWorktree": false,
    "devEnv": "native",
    "parallelism": 3,
    "layout": "single-nextjs",
    "backendHost": "render"
  },
  "capabilities": {
    "email": "per-startup",
    "emailSuggested": "resend",
    "messaging": "whatsapp-cloud-api",
    "otpCostCascade": true,
    "analytics": "posthog",
    "errors": "sentry",
    "logs": "axiom",
    "uptime": "better-stack",
    "payments": "mercadopago",
    "paymentsAdapter": true
  },
  "library": {
    "kind": "util",
    "layout": "single",
    "language": "typescript",
    "build": "tsdown",
    "format": "dual",
    "publish": "npm",
    "docs": "typedoc",
    "testing": "vitest",
    "monetization": "freemium",
    "mint": "polar",
    "licenseGate": "online",
    "apiSpec": "openapi",
    "sdkTargets": ["typescript"]
  },
  "mobile": {
    "framework": "expo",
    "targets": ["ios", "android"],
    "language": "typescript",
    "router": "expo-router",
    "updates": "eas-updates",
    "distribution": "eas",
    "testing": "jest-expo+rntl+maestro",
    "push": "expo-notifications",
    "analytics": "posthog",
    "errors": "sentry",
    "payments": "stores",
    "nativeEscape": "expo-prebuild",
    "shared": "monorepo"
  },
  "product": {
    "discovery": "lean-canvas+jtbd",
