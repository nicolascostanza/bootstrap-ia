  "testing": {
    "stack": "jest+rtl+playwright",
    "philosophy": "spec-first + behavior",
    "coverageTarget": 90,
    "coverageScope": "domain+services",
    "coverageGate": "ratchet",
    "e2eScope": "broad",
    "e2eCadence": {
      "critical": "on-pr",
      "full": "nightly"
